#!/bin/bash
set -euo pipefail
umask 077
export DEBIAN_FRONTEND=noninteractive
apt-get update -qq
apt-get install -y -qq docker.io docker-compose-v2 python3
systemctl enable --now docker
device=/dev/disk/by-id/google-editorial-data
mkdir -p /srv/trimbin
# Format only a genuinely unformatted disk. Existing filesystems are retained.
if ! blkid "$device" >/dev/null 2>&1; then
  mkfs.ext4 -F "$device"
fi
mountpoint -q /srv/trimbin || mount "$device" /srv/trimbin
mkdir -p /srv/trimbin/releases /srv/trimbin/data
python3 - <<'PY'
import base64, hashlib, json, os, pathlib, re, tarfile, urllib.request
base = pathlib.Path("/srv/trimbin")
def fetch(url, token=None):
    headers = {"Authorization": "Bearer " + token} if token else {"Metadata-Flavor": "Google"}
    with urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=120) as r:
        return r.read()
token = json.loads(fetch("http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token"))["access_token"]
from urllib.parse import quote
url = "https://storage.googleapis.com/storage/v1/b/" + quote("${release_bucket}", safe="") + "/o/" + quote("${release_object}", safe="") + "?alt=media"
data = fetch(url, token)
if hashlib.sha256(data).hexdigest() != "${release_sha256}":
    raise RuntimeError("Release hash mismatch")
release = base / "releases" / "${release_sha256}"
if not release.exists():
    temporary = base / "release.tar.gz"
    temporary.write_bytes(data)
    release.mkdir()
    with tarfile.open(temporary) as archive:
        archive.extractall(release, filter="data")
    temporary.unlink()
private = base / "private" / "foundation"
private.mkdir(parents=True, exist_ok=True, mode=0o700)
secret_url = "https://secretmanager.googleapis.com/v1/projects/${project_id}/secrets/${foundation_secret_id}/versions/latest:access"
payload = json.loads(fetch(secret_url, token))
credentials = json.loads(base64.b64decode(payload["payload"]["data"]))
required = {"postgres_admin", "postgres_writer", "clickhouse_admin", "clickhouse_writer", "clickhouse_reader", "session_secret"}
if set(credentials) != required or any(not isinstance(v, str) or not re.fullmatch("[0-9a-f]{64}", v) for v in credentials.values()):
    raise RuntimeError("Invalid foundation secret manifest")
for name in required:
    target = private / name
    if target.exists() and target.read_text() != credentials[name]:
        raise RuntimeError("Secret rotation requires an explicit database rotation procedure")
    target.write_text(credentials[name])
    target.chmod(0o444 if name in {"postgres_admin", "postgres_writer", "clickhouse_admin"} else 0o600)
(private / "compose.env").write_text("TRIMBIN_FOUNDATION_DATA=/srv/trimbin/data\nTRIMBIN_FOUNDATION_SECRETS=" + str(private) + "\n")
runtime_file = private / "runtime.env"
if not runtime_file.exists():
    runtime = (release / ".env.example").read_text()
    runtime = runtime.replace("TRIMBIN_PROFILE=development", "TRIMBIN_PROFILE=cloud-poc")
    runtime = runtime.replace("TRIMBIN_INFERENCE_MODE=fixture", "TRIMBIN_INFERENCE_MODE=nebius")
    values = {
        "TRIMBIN_DATABASE_URL": "postgresql://trimbin_writer:" + credentials["postgres_writer"] + "@127.0.0.1:5432/trimbin",
        "TRIMBIN_CLICKHOUSE_PASSWORD": credentials["clickhouse_writer"],
        "TRIMBIN_CLICKHOUSE_READER_PASSWORD": credentials["clickhouse_reader"],
        "TRIMBIN_SESSION_SECRET": credentials["session_secret"],
    }
    for key, value in values.items():
        runtime = runtime.replace(key + "=\n", key + "=" + value + "\n")
    runtime_file.write_text(runtime)
    runtime_file.chmod(0o600)
for name, target in ((".secrets", base / "private"), (".foundation-data", base / "data")):
    link = release / name
    if not link.exists():
        link.symlink_to(target, target_is_directory=True)
current = base / "current"
replacement = base / "next"
replacement.unlink(missing_ok=True)
replacement.symlink_to(release, target_is_directory=True)
replacement.replace(current)
PY
cd /srv/trimbin/current
docker compose --env-file .secrets/foundation/compose.env -f deploy/foundation/compose.yaml up -d --wait
# Database migration/role initialization and application cutover are explicit release
# steps. This Phase 2 host bootstrap does not claim to deploy the finished editor.
