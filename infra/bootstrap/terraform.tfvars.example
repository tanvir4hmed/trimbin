# Copy to terraform.tfvars and fill in. That file is gitignored and must stay so.
#
# Nothing here is a secret — these are identifiers, not credentials. They are kept
# out of version control because they are environment-specific, not because they
# would be dangerous to publish.

project_id        = "trimbin-xxxxx"
region            = "us-central1"
github_repository = "tanvir4hmed/trimbin"

# Not optional in practice, whatever "optional" suggests.
#
# Empty means count = 0 and no budget guard exists — nothing watches spend, and
# nothing says so. This sat empty for weeks beside a comment claiming the
# alerting was set elsewhere. It was not.
#
# Needs billing-account-level
# permission, which not every account has. Find the id with:
#   gcloud billing accounts list
billing_account_id = ""
monthly_budget_usd = 100
