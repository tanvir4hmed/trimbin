# Portable development only. Generate real local secrets with tools/foundation.py init.
# Legacy deployments keep their existing environment until explicit cutover.
TRIMBIN_PROFILE=development
TRIMBIN_INFERENCE_MODE=fixture
TRIMBIN_DATABASE_URL=
TRIMBIN_CLICKHOUSE_HOST=127.0.0.1
TRIMBIN_CLICKHOUSE_PORT=8123
TRIMBIN_CLICKHOUSE_SECURE=false
TRIMBIN_CLICKHOUSE_USER=trimbin_writer
TRIMBIN_CLICKHOUSE_PASSWORD=
TRIMBIN_CLICKHOUSE_READER_USER=trimbin_reader
TRIMBIN_CLICKHOUSE_READER_PASSWORD=
TRIMBIN_SESSION_SECRET=
TRIMBIN_DEMO_PASS=
TRIMBIN_MEDIA_BACKEND=filesystem
TRIMBIN_ORIGINALS_ROOT=
TRIMBIN_PROXIES_ROOT=
TRIMBIN_EXPORT_ROOT=
TRIMBIN_ALLOWED_MEDIA_ROOTS=[]
TRIMBIN_STAGING_ROOT=
TRIMBIN_MEDIA_ROOTS={}
TRIMBIN_MEDIA_ROOT_PROJECTS={}
TRIMBIN_MEDIA_THREADS=2
TRIMBIN_MEDIA_WORK_BYTES=2147483648
TRIMBIN_MEDIA_RESERVE_BYTES=1073741824
TRIMBIN_MEDIA_TIMEOUT_SECONDS=3600
# Optional local password sign-in: email:password pairs. Store only in a private env file.
TRIMBIN_TEAM_PASSES=
TRIMBIN_CORS_ORIGINS=["http://localhost:3000"]
TRIMBIN_NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Deliberately nonfunctional placeholders. Never register these as working GitHub Secrets.
TRIMBIN_NEBIUS_API_KEY=DUMMY_REPLACE_ME_NEBIUS_API_KEY
TRIMBIN_VISION_MODEL=DUMMY_VISION_MODEL
TRIMBIN_REASONING_MODEL=DUMMY_REASONING_MODEL
TRIMBIN_ASR_MODEL=DUMMY_ASR_MODEL
TRIMBIN_EMBEDDING_MODEL=DUMMY_EMBEDDING_MODEL
TRIMBIN_EMBEDDING_VERSION=DUMMY_EMBEDDING_GENERATION
TRIMBIN_INFERENCE_LIVE_ENABLED=false
# Relative to the API working directory. Copy and edit privately after model discovery.
TRIMBIN_INFERENCE_CATALOG_PATH=../config/model-profiles.example.json
TRIMBIN_INFERENCE_TIMEOUT_SECONDS=120
TRIMBIN_INFERENCE_MAX_RETRIES=1
TRIMBIN_INFERENCE_MAX_OUTPUT_TOKENS=8192
TRIMBIN_INFERENCE_TEMPERATURE=0
TRIMBIN_INFERENCE_RESPONSE_BYTES=8388608
TRIMBIN_TAVILY_API_KEY=DUMMY_REPLACE_ME_TAVILY_API_KEY
LANGSMITH_API_KEY=DUMMY_REPLACE_ME_LANGSMITH_API_KEY
LANGSMITH_PROJECT=trimbin-development
LANGSMITH_TRACING=false
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
# Optional; the actual integration is not enabled by a placeholder.
TOLOKA_API_KEY=DUMMY_REPLACE_ME_TOLOKA_API_KEY
